# Credenciales de la cuenta de servicio de Google Cloud (Google Calendar API).
# Ver instrucciones de configuración en la conversación / README del proyecto.

GOOGLE_CLIENT_EMAIL=

# Pegar la private_key del JSON de la cuenta de servicio tal cual, entre comillas,
# dejando los "\n" literales (no reemplazarlos por saltos de línea reales acá).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID del calendario compartido del salón (Ajustes del calendario > Integrar calendario).
GOOGLE_CALENDAR_ID=
