    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.5.0",
    "react-router-hash-link": "^2.4.3",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.10",
